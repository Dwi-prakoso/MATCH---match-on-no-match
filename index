function appShell(content){const r=route(),activeMode=getActiveMode(),inboxCount=state.invitations.filter(i=>i.candidateId==='me'&&i.status==='Invited').length+state.evidence.filter(e=>e.ownerId==='me'&&grantState(e)==='Requested').length;return `<div class="shell"><aside class="sidebar"><div class="brand" data-action="go" data-to="" role="button" tabindex="0" aria-label="Match beranda"><img data-logo="header" src="${themeLogo()}" alt="Match" /></div><div class="nav-label">Workspace</div><nav aria-label="Navigasi utama" class="sidenav">${navItem('home','Beranda','home')}${navItem('explore','Jelajahi','compass')}${navItem('recruit/new','Rekrut Anggota','users')}${navItem('inbox','Inbox','inbox',inboxCount)}<div style="height:10px"></div><div class="nav-label" style="margin-left:12px">Akun</div>${navItem('profile/me','Profil Saya','user')}${navItem('settings','Pengaturan','settings')}</nav><div class="sidebar-bottom"><div class="sidebar-note"><strong>⌘ Satu profil, dua cara main.</strong><span>Cari rekan, bangun tim, dan sepakat soal komitmen.</span></div><div class="sidebar-user"><span class="avatar violet">${esc(state.profile.nickname.slice(0,1).toUpperCase())}</span><span><strong>${esc(state.profile.nickname)}</strong><br><span class="muted">Akun demo · data lokal</span></span></div></div></aside><main class="main"><header class="topbar"><div class="topbar-left"><button class="mobile-home" data-action="go" data-to="home" title="Beranda" aria-label="Ke beranda"><img class="mobile-brand" data-logo="mobileicon" src="${effectiveTheme()==='dark'?IMAGES.monoLight:IMAGES.monoDark}" alt=""/></button><div class="topbar-kicker">Match / On</div><div class="topbar-sep"></div><div class="topbar-title">${esc(routeTitle(r))}</div></div><div class="topbar-actions">${!IS_PREVIEW_FRAME?`<button class="device-toggle" data-action="device-preview" aria-label="Preview versi mobile" title="Lihat versi mobile">${icon('phone',17)}<span>Mobile view</span></button>`:''}<span class="tiny-note">● PROTOTYPE</span><div style="position:relative"><button class="theme-toggle" data-action="theme-menu" aria-expanded="${ui.themeMenu}" title="Ubah tema"><span class="theme-icon">${icon(effectiveTheme()==='dark'?'moon':'sun',18)}</span><span class="theme-text" data-theme-text>${effectiveTheme()==='dark'?'Night':'Light'}</span><span style="font-size:10px">▾</span></button>${ui.themeMenu?`<div class="theme-picker" id="theme-picker">${[['light','☀ Light mode'],['dark','☾ Night mode'],['system','◈ System']].map(([v,l])=>`<button data-action="set-theme" data-theme-choice="${v}" class="${state.theme===v?'selected':''}">${l}</button>`).join('')}</div>`:''}</div><button class="avatar top-avatar" data-action="go" data-to="profile/me" aria-label="Profil saya">${esc(state.profile.nickname.slice(0,1).toUpperCase())}</button></div></header><div class="mobile-mode-bar"><div class="mobile-mode-label">MODE</div><div class="mobile-mode-switch" role="group" aria-label="Pilih mode Match"><button class="${activeMode==='join'?'active join':''}" data-action="app-mode" data-mode="join" aria-pressed="${activeMode==='join'}">${icon('compass',16)}<span>Cari Tim</span></button><button class="${activeMode==='recruit'?'active recruit':''}" data-action="app-mode" data-mode="recruit" aria-pressed="${activeMode==='recruit'}">${icon('users',16)}<span>Cari Anggota</span></button></div><button class="mobile-create-team" data-action="go" data-to="recruit/new" aria-label="Buat tim baru" title="Buat tim baru">${icon('plus',20)}</button></div><div class="content">${content}<footer style="border-top:2px solid var(--soft-line);margin-top:45px;padding:20px 0 8px;display:flex;gap:15px;flex-wrap:wrap;justify-content:space-between;font-size:12px;color:var(--muted)"><span><b>MATCH</b> — Skill ada. Tim mana?</span><span>Prototype interaktif · Data contoh · Tidak terhubung server</span></footer></div></main><nav class="mobile-nav" aria-label="Navigasi seluler">${[['explore','compass','Explore'],['recruit/new','u