function explore(){const q=queryMode();if(q==='people'||q==='teams')state.exploreMode=q;let isTeam=state.exploreMode!=='people';let f=ui.filter;let list=isTeam?state.teams.filter(t=>{let role=t.roles[0];let str=(t.name+' '+t.competition+' '+role.name+' '+role.skills.join(' ')).toLowerCase();return(!f.search||str.includes(f.search.toLowerCase()))&&(!f.role||role.skills.join(' ').toLowerCase().includes(f.role.toLowerCase())||role.name.toLowerCase().includes(f.role.toLowerCase()))&&(!f.region||t.region.toLowerCase().includes(f.region.toLowerCase())||t.workMode==='Online')&&(f.workMode==='all'||t.workMode===f.workMode)&&(!f.minHours||Number(role.hours)<=Number(f.minHours))&&(!f.onlyOpen||t.status==='Open')}):state.people.filter(p=>{let str=(p.nickname+' '+p.label+' '+p.skills.join(' ')).toLowerCase();return(!f.search||str.includes(f.search.toLowerCase()))&&(!f.role||str.includes(f.role.toLowerCase()))&&(!f.region||p.region.toLowerCase().includes(f.region.toLowerCase())||p.workMode==='Online')&&(f.workMode==='all'||p.workMode===f.workMode)&&(!f.minHours||Number(p.hours)>=Number(f.minHours))});return `<div class="explore-banner"><div><div class="eyebrow" style="color:#000">${isTeam?'DISCOVER / JOIN':'DISCOVER / RECRUIT'}</div><h1>${isTeam?'CARI TIM.':'CARI ANGGOTA.'}</h1><p>${isTeam?'Skill ada. Cari tim yang butuh kamu.':'Cari partner yang cocok skill dan komitmen.'}</p></div><div class="banner-doodle">${isTeam?'↗':'✳'}</div></div><div class="between explore-desktop-modes" style="margin:0 0 14px"><div class="segmented" role="tablist" aria-label="Mode jelajah"><button data-action="explore-mode" data-mode="teams" role="tab" aria-selected="${isTeam}" class="${isTeam?'active':''}">↗ Cari Tim</button><button data-action="explore-mode" data-mode="people" role="tab" aria-selected="${!isTeam}" class="${!isTeam?'active violet-active':''}">✳ Cari Anggota</button></div><span class="fine muted" style="text-align:right">Satu akun, dua mode.</span></div><div class="filters ${ui.expandedFilter?'mobile-expanded':''}"><div class="field"><label for="filter-search">Cari ${isTeam?'tim / kompetisi':'nama / keahlian'}</label><input id="filter-search" placeholder="${isTeam?'Mis. Finance, NovaRise...':'Mis. Alya, UI/UX...'}" value="${esc(f.search)}" /></div><div class="field"><label for="filter-role">Skill / peran</label><input id="filter-role" placeholder="Semua skill" value="${esc(f.role)}" /></div><div class="field"><label for="filter-region">Kota / area (opsional)</label><input id="filter-region" placeholder="Mis. Depok" value="${esc(f.region)}" /></div><div class="field"><label for="filter-workMode">Mode kerja</label><select id="filter-workMode">${['all','Online','Hybrid','Offline'].map(x=>`<option value="${x}" ${f.workMode===x?'selected':''}>${x==='all'?'Semua mode':x}</option>`).join('')}</select></div><button class="btn lime" data-action="apply-filter">${icon('search',16)} Filter</button><button class="mobile-filter-toggle" data-action="toggle-mobile-filters" aria-expanded="${ui.expandedFilter}" type="button">${icon('filter',16)}<span class="mobile-filter-label">${ui.expandedFilter?'Tutup filter lanjutan':'Filter lanjutan'}</span><span class="filter-toggle-arrow">⌄</span></button><div class="filter-extra"><label class="checkline"><input type="checkbox" id="filter-open" ${f.onlyOpen?'checked':''} ${!isTeam?'disabled':''}/> Tim open recruitment</label><label class="checkline">${isTeam?'Maks.':'Min.'} jam/minggu <input id="filter-hours" type="number" min="1" max="60" value="${esc(f.minHours)}" placeholder="Bebas" style="width:70px;padding:6px;border:2px solid var(--border);background:var(--canvas);color:var(--ink);border-radius:4px"></label><span class="muted">Area diisi manual · tidak pakai GPS</span><button class="text-link" data-action="clear-filters">Hapus Filter</button></div></div><div class="results-summary"><strong>${list.length} ${isTeam?'tim':'kandidat'} ditemukan</strong><span class="fine muted">Hasil data contoh, bukan hasil verifikasi</sp