function animateNavigate(source,to,color){if(ui.animating)return;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;if(reduced){go(to);return}ui.animating=true;const rect=source.getBoundingClientRect();let overlay=document.createElement('div');overlay.className='nav-morph';overlay.style.cssText=`left:${rect.x}px;top:${rect.y}px;width:${rect.width}px;height:${rect.height}px;background:${color};border-radius:10px;`;document.body.appendChild(overlay);overlay.animate([{left:rect.x+'px',top:rect.y+'px',width:rect.width+'px',height:rect.height+'px',borderRadius:'10px'},{left:'0px',top:'0px',width:'100vw',height:'100vh',borderRadius:'0px'}],{duration:420,easing:'cubic-bezier(.22,1,.36,1)',fill:'forwards'}).finished.then(()=>{go(to);overlay.remove();ui.animating=false}).catch(()=>{overlay.remove();ui.animating=false;go(to)})}
