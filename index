function validateStep(step){const d=state.recruitDraft;const required=step===1?['name','competition','year','category']:step===2?['role','skills','slots','hours','meeting','goal','plan']:['workMode'];ui.draftErrors={};for(let k of required){if(!String(d[k]||'').trim())ui.draftErrors[k]='Bagian ini wajib diisi.'}if(step===1&&d.year&&(!/^\d{4}$/.test(String(d.year))||Number(d.year)<2000||Number(d.year)>2100))ui.draftErrors.year='Isi tahun 4 digit yang valid.';if(step===2){if(!(Number(d.hours)>0&&Number(d.hours)<=80))ui.draftErrors.hours='Isi 1–80 jam per minggu.';if(!(Number.isInteger(Number(d.slots))&&Number(d.slots)>0&&Number(d.slots)<21))ui.draftErrors.slots='Isi 1–20 slot.'}return !Object.keys(ui.draftErrors).length}
