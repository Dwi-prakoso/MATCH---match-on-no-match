function profile(id){const p=person(id);if(!p)return notFound();const own=id==='me';const publicRecords=state.records.filter(r=>r.userId===id&&(own||r.public));const pinned=publicRecords.filter(r=>r.public&&r.pinned).slice(0,3),rest=publicRecords.filter(r=>!pinned.some(z=>z.id===r.id));return `<button class="btn small ghost" data-action="go" data-to="explore?mode=people" style="margin-bottom:20px">${icon('back',16)} Kembali</button><div class="profile-cover"><div><span class="sticker white">${own?'PROFIL SAYA':'PUBLIC PROFILE / DEMO'}</span><h1>${esc(p.nickname)} <span style="font-size:.45em">↗</span></h1><div class="row"><span class="sticker violet">${esc(p.label)}</span><span class="fine" style="font-weight:800">${esc(p.region||'Area tidak dibagikan')}</span></div><p style="margin-top:13px">${esc(p.status||p.declaredStatus)} ${p.campus?'· '+esc(p.campus):''}</p></div><div class="avatar white">${esc(p.nickname.slice(0,1).toUpperCase())}</div></div><div class="detail-grid"><section class="stack"><div class="block-card"><div class="between"><h2 class="info-title">01 / Skill & ketersediaan</h2><span class="sticker neutral">Self-declared</span></div><div class="tags">${(p.skills||[]).map(s=>`<span class="tag">${esc(s)}</span>`).join('')}</div><div class="commit-grid" style="margin-top:17px"><div class="commit-box"><span class="fine muted">Komitmen</span><strong>${esc(p.hours)} jam/minggu</strong></div><div class="commit-box"><span class="fine muted">Preferensi kerja</span><strong>${esc(p.workMode)}</strong></div></div></div><div class="block-card"><div class="between"><h2 class="info-title">02 / Top track record</h2><span class="fine muted">${pinned.length}/3 highlight</span></div>${pinned.length?`<div class="trophy-grid">${pinned.map((r,i)=>`<div class="trophy"><div class="trophy-number">0${i+1} / RECORD</div><h4>${esc(r.title)}</h4><p>${esc(r.year)} · ${esc(r.organization||'Pernyataan pengguna')}</p><div class="tags" style="margin-top:9px"><span class="sticker neutral">Dinyatakan pengguna</span>${r.evidence?`<span class="sticker white">${icon('lock',12)} Bukti tersedia</span>`:''}</div></div>`).join('')}</div>`:`<p class="muted fine">Belum ada rekam jejak yang ditampilkan publik.</p>`}<div class="rule"></div><div class="between"><h3>Riwayat lengkap</h3><span class="fine muted">${publicRecords.length}/20 entri</span></div><div class="record-list" style="margin-top:13px">${[...pinned,...(ui.profileMore?rest:[])].map(r=>`<div class="record-row"><div style="min-width:0"><strong>${esc(r.title)}</strong><small>${esc(r.year)} · ${esc(r.organization||'Tidak dicantumkan')}</small><div class="tags"><span class="tag slim">Dinyatakan pengguna</span>${r.evidence?`<span class="tag slim">${icon('lock',12)} Bukti tersedia · belum diverifikasi</span>`:''}${!r.public&&own?`<span class="tag slim">Privat</span>`:''}</div></div><div class="row">${r.evidence?`<button class="btn small" data-action="${own?'view-own-evidence':'open-evidence'}" data-id="${esc(r.id)}">${own?'Atur bukti':'Minta bukti'}</button>`:''}${own?`<button class="btn small ghost" data-action="toggle-record-public" data-id="${esc(r.id)}" title="Ubah visibilitas">${r.public?'Sembunyikan':'Publikasikan'}</button>`:''}</div></div>`).join('')}</div>${rest.length?`<button class="btn small" data-action="toggle-more" style="margin-top:15px">${ui.profileMore?'Tampilkan lebih sedikit':'Lihat semua '+publicRecords.length+' entri'} ${icon('chevron',15)}</button>`:''}${own?`<button class="btn lime small" style="margin-top:15px" data-action="add-record">+ Tambah track record</button>`:''}</div></section><aside class="detail-side"><div class="privacy-panel"><div class="locked-icon">${icon('lock',29)}</div><h2>BUKTI PRIVAT.<br>IZIN DULU.</h2><p style="margin-top:12px">Hanya judul yang dipilih pemilik menjadi publik. File pendukung tidak bisa dilihat tanpa persetujuan per dokumen.</p><div class="rule" style="background:#555"></div>${own?`<button class="btn lime full" data-action="go" data-to="settings">Kelola privasi ${icon('arrow',16)}</button>`:`<button class="btn lime full" data-action="open-invite" data-id="${esc(id)}">Undang ${esc(p.nickname)} ${icon('arrow',16)}</button>`}</div>${own?`<div class="block-card" style="margin-top:19px"><h3>Profil publikmu</h3><p class="fine muted" style="margin:9px 0">Periksa judul pencapaian, karena beberapa judul dapat mengidentifikasi pemiliknya.</p><button class="btn small" data-action="go" data-to="settings">Ubah informasi akun</button></div>`:''}</aside></div>`}
function recruitNew(){const d=state.recruitDraft,step=ui.step;const fld=(name,label,placeholder='',extra='')=>`<div class="field ${extra}"><label for="draft-${name}">${label}</label><input id="draft-${name}" data-draft="${name}" value="${esc(d[name])}" placeholder="${esc(placeholder)}" />${ui.draftErrors[name]?`<span class="err">${esc(ui.draftErrors[name])}</span>`:''}</div>`;let fields='';if(step===1)fields=`${fld('name','Nama tim *','Contoh: Stellar Squad')}${fld('competition','Nama kompetisi *','Contoh: National Innovation Cup')}${fld('year','Tahun kompetisi *','2026')}${fld('category','Kategori lomba *','Contoh: Business Plan')}`;
else if(step===2)fields=`${fld('role','Peran yang dibuka *','Contoh: Researcher')}${fld('skills','Skill yang dibutuhkan (pisah koma) *','Research, Excel')}${fld('slots','Jumlah slot *','1')}${fld('hours','Jam kontribusi / minggu *','6')}${fld('meeting','Jadwal koordinasi *','Selasa & Jumat malam','wide')}${fld('goal','Target kompetisi *','Contoh: Lolos final','wide')}${fld('plan','Rencana kerja yang konkret *','Contoh: Riset tiap minggu, review bersama','wide')}`;
else fields=`<div class="field"><label for="draft-workMode">Preferensi kerja *</label><select id="draft-workMode" data-draft="workMode">${['Online','Hybrid','Offline'].map(x=>`<option value="${x}" ${d.workMode===x?'selected':''}>${x}</option>`).join('')}</select></div>${fld('region','Area / kota (opsional)','Depok, Jakarta...')}<div class="field wide"><div class="notice neutral">${icon('shield',16)} Kompetisi adalah konteks yang diisi perekrut. Match tidak mengklaim penyelenggara atau sertifikat telah diverifikasi.</div></div>`;
return `<div class="recruit-intro"><div><div class="eyebrow" style="color:#fff">TEAM BUILDER / CREATE</div><h1>BENTUK TIM.<br>CARI YANG KLIK.</h1><p>Jelaskan posisi, jadwal, dan ekspektasi sebelum seseorang melamar.</p></div><span style="font-size:64px;font-weight:900;line-height:1">✳</span></div><div class="recruit-layout"><section class="block-card"><div class="between" style="margin-bottom:18px"><h2 class="subhead">Buat rekrutmen</h2><span class="sticker violet">LANGKAH ${step}/3</span></div><div class="steps-track">${[['1','Tim & lomba'],['2','Role & komitmen'],['3','Publikasikan']].map(([n,label])=>`<div class="step-node ${Number(n)===step?'current':Number(n)<step?'complete':''}"><span class="step-num">${Number(n)<step?'✓':n}</span><span>${label}</span></div>`).join('')}</div><form id="recruit-form" novalidate><div class="form-grid view-reveal" id="form-step">${fields}</div><div class="form-buttons">${step>1?`<button type="button" class="btn" data-action="recruit-back">${icon('back',16)} Kembali</button>`:''}<button type="submit" class="btn ${step===3?'violet':'lime'}">${step===3?'Publikasikan Tim':'Selanjutnya'} ${icon('arrow',16)}</button></div></form></section><aside class="live-preview"><div class="block-card"><div class="preview-kicker">↗ LIVE PREVIEW / TEAM COMMITMENT CARD</div><div class="preview-paper"><span class="sticker neutral" id="preview-status">DRAFT · BELUM DIPUBLIKASIKAN</span><h3 id="preview-name">${esc(d.name||'Nama timmu di sini.')}</h3><p id="preview-competition">${esc(d.competition||'Nama kompetisi')} · ${esc(d.year||'Tahun')}</p><div class="rule"></div><div class="mini-row"><span class="fine muted">Dicari</span><strong id="preview-role">${esc(d.role||'Role belum diisi')}</strong></div><div class="mini-row"><span class="fine muted">Kontribusi</span><strong id="preview-hours">${esc(d.hours||'—')} jam/minggu</strong></div><div class="mini-row"><span class="fine muted">Pertemuan</span><strong id="preview-meeting">${esc(d.meeting||'Belum diisi')}</strong></div><div class="mini-row"><span class="fine muted">Mode</span><strong id="preview-mode">${esc(d.workMode)}</strong></div><div class="tags" style="margin-top:14px" id="preview-skills">${skills(d.skills).map(s=>`<span class="tag slim">${esc(s)}</span>`).join('')}</div></div><p class="fine muted" style="margin-top:12px">Preview mengikuti inputmu. Publikasi hanya tersimpan di browser ini.</p></div></aside></div><div class="between" style="margin:26px 0 8px"><h2 class="subhead">Tim yang kamu kelola</h2><span class="fine muted">${state.teams.filter(t=>t.ownerId==='me').length} tim</span></div><div class="card-grid">${state.teams.filter(t=>t.ownerId==='me').map(teamCard).join('')}</div>`}
function recruitApplicants(id){let t=team(id);if(!t||t.ownerId!=='me')return notFound();const apps=state.applications.filter(a=>a.teamId===id),invites=state.invitations.filter(i=>i.teamId===id);return `<div class="page-heading"><div><div class="eyebrow">RECRUITMENT BOARD / ${esc(t.name)}</div><h1 class="section-title">Pelamar & undangan.</h1><p>Shortlist kandidat, periksa profil publik, lalu minta bukti spesifik apabila diperlukan.</p></div><button class="btn lime" data-action="go" data-to="explore?mode=people">Cari Kandidat ${icon('arrow',16)}</button></div><div class="stat-grid"><div class="stat"><strong>${apps.length}</strong><span>Lamaran masuk</span></div><div class="stat"><strong>${invites.length}</strong><span>Undangan dikirim</span></div><div class="stat"><strong>${state.memberships.filter(m=>m.teamId===id).length}</strong><span>Anggota dikonfirmasi</span></div></div><h2 class="subhead" style="margin-bottom:15px">Lamaran masuk</h2><div class="inbox-layout">${apps.length?apps.map(a=>{let p=person(a.candidateId);return `<article class="inbox-item"><div><span class="sticker neutral">${esc(formatStatus(a.status))}</span><h3>${esc(p?.nickname)} → ${esc(t.name)}</h3><p>${esc(t.roles[0].name)} · ${esc(a.intro||'Belum ada pesan pengantar')} · ${esc(p?.hours)} jam/minggu tersedia</p></div><div class="actions"><button class="btn small" data-action="go" data-to="profile/${esc(a.candidateId)}">Lihat Profil</button>${a.status==='Applied'?`<button class="btn lime small" data-action="shortlist-app" data-id="${esc(a.id)}">Shortlist</button>`:''}${a.status==='Shortlisted'?`<button class="btn violet small" data-action="invite-app" data-id="${esc(a.id)}">Undang</button>`:''}${a.status==='Accepted'?`<button class="btn lime small" data-action="final-confirm-app" data-id="${esc(a.id)}">Konfirmasi akhir</button>`:''}</div></article>`}).join(''):`<div class="empty-state"><h3>Belum ada pelamar.</h3><p>Coba telusuri kandidat dan kirim undangan.</p><button class="btn lime" data-action="go" data-to="explore?mode=people">Cari Anggota</button></div>`}</div><h2 class="subhead" style="margin:27px 0 16px">Undangan tim</h2><div class="inbox-layout">${invites.length?invites.map(i=>{let p=person(i.candidateId);return `<article class="inbox-item"><div><span class="sticker neutral">${esc(formatStatus(i.status))}</span><h3>${esc(p?.nickname)} · ${esc(t.roles[0].name)}</h3><p>Undangan bukan konfirmasi keanggotaan. Kandidat harus menyetujui terlebih dahulu.</p></div><div class="actions"><button class="btn small" data-action="go" data-to="profile/${esc(i.candidateId)}">Profil</button>${i.status==='Invited'?`<button class="btn small" data-action="simulate-candidate" data-id="${esc(i.id)}">Demo: kandidat terima</button>`:''}${i.status==='Accepted'?`<button class="btn lime small" data-action="final-confirm-invite" data-id="${esc(i.id)}">Konfirmasi akhir</button>`:''}</div></article>`}).join(''):`<div class="notice neutral">Belum ada undangan terkirim untuk tim ini.</div>`}</div>`}
function inbox(){persistExpire();const tabs=[['invites','Undangan',state.invitations.filter(i=>i.candidateId==='me'&&['Invited','Accepted','Confirmed','Rejected'].includes(i.status)).length],['applications','Lamaran',state.applications.filter(a=>a.candidateId==='me').length],['evidence','Akses Bukti',state.evidence.length],['teams','Tim Saya',state.teams.filter(t=>t.ownerId==='me').length]];let t=ui.inboxTab;let body='';if(t==='invites'){const rows=state.invitations.filter(i=>i.candidateId==='me');body=rows.length?rows.map(i=>{let tm=team(i.teamId),r=tm?.roles.find(r=>r.id===i.roleId);return `<article class="inbox-item"><div><span class="sticker ${i.status==='Invited'?'violet':'neutral'}">${esc(formatStatus(i.status))}</span><h3>${esc(tm?.name)} mengundangmu</h3><p>${esc(tm?.competition)} ${esc(tm?.year)} · ${esc(r?.name)} · ${esc(r?.hours)} jam/minggu · ${esc(r?.meeting)}</p></div><div class="actions"><button class="btn small" data-action="go" data-to="team/${esc(tm?.id)}">Bandingkan</button>${i.status==='Invited'?`<button class="btn lime small" data-action="accept-invite" data-id="${esc(i.id)}">Terima</button><button class="btn small" data-action="decline-invite" data-id="${esc(i.id)}">Tolak</button>`:''}${i.status==='Accepted'?`<button class="btn violet small" data-action="demo-recruiter-confirm" data-id="${esc(i.id)}">Demo: perekrut konfirmasi</button>`:''}</div></article>`}).join(''):'<div class="empty-state"><h3>Belum ada undangan.</h3><p>Jelajahi tim yang sedang buka rekrutmen.</p></div>'}
else if(t==='applications'){const rows=state.applications.filter(a=>a.candidateId==='me');body=rows.length?rows.map(a=>{let tm=team(a.teamId);return `<article class="inbox-item"><div><span class="sticker neutral">${esc(formatStatus(a.status))}</span><h3>Lamaran ke ${esc(tm?.name)}</h3><p>${esc(tm?.competition)} ${esc(tm?.year)} · ${esc(a.intro||'Tanpa pengantar')} · Bukti privat tidak ikut dikirim.</p></div><div class="actions"><button class="btn small" data-action="go" data-to="team/${esc(a.teamId)}">Lihat Tim</button>${a.status==='Applied'?`<button class="btn small" data-action="withdraw-app" data-id="${esc(a.id)}">Batalkan</button>`:''}</div></article>`}).join(''):'<div class="empty-state"><h3>Belum ada lamaran.</h3><p>Temukan tim dan kirim lamaran pertamamu.</p><button class="btn lime" data-action="go" data-to="explore?mode=teams">Cari Tim</button></div>'}
else if(t==='evidence'){body=state.evidence.map(g=>{let r=record(g.recordId),incoming=g.ownerId==='me',s=grantState(g);return `<article class="inbox-item"><div><span class="sticker ${s==='Approved'?'':'neutral'}">${esc(formatStatus(s))}</span><h3>${incoming?'Permintaan masuk dari '+esc(g.requesterName||nameOf(g.requesterId)):'Permintaan bukti '+esc(nameOf(g.ownerId))}</h3><p>${esc(r?.title)} · Dokumen spesifik · ${incoming?'Kamu sebagai pemilik':'Kamu sebagai pemohon'} · ${s==='Requested'?'Akan kedaluwarsa 72 jam sejak permintaan':s==='Revoked'?'Akses telah dicabut':'Persetujuan bukan keanggotaan tim'}</p></div><div class="actions">${incoming&&s==='Requested'?`<button class="btn lime small" data-action="approve-evidence" data-id="${esc(g.id)}">Izinkan</button><button class="btn small" data-action="reject-evidence" data-id="${esc(g.id)}">Tolak</button>`:''}${incoming&&s==='Approved'?`<button class="btn small" data-action="revoke-evidence" data-id="${esc(g.id)}">Cabut akses</button>`:''}${!incoming&&s==='Requested'?`<button class="btn small" data-action="demo-owner-approve" data-id="${esc(g.id)}">Demo: pemilik izinkan</button><button class="btn small" data-action="demo-owner-reject" data-id="${esc(g.id)}">Demo: pemilik tolak</button>`:''}${!incoming&&s==='Approved'?`<button class="btn lime small" data-action="view-evidence" data-id="${esc(g.recordId)}">Buka bukti demo</button>`:''}</div></article>`}).join('')||'<div class="notice neutral">Tidak ada permintaan dokumen.</div>'}
