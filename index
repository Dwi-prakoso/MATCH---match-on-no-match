if(action==='accept-invite'){let i=state.invitations.find(i=>i.id===id);if(i?.status==='Invited')chooseInvite(i,'accept');return}
if(action==='decline-invite'){let i=state.invitations.find(i=>i.id===id);if(i?.status==='Invited')chooseInvite(i,'reject');return}
if(action==='demo-recruiter-confirm'||action==='final-confirm-invite'){const i=state.invitations.find(i=>i.id===id);if(i?.status==='Accepted')tryFinal(i);return}
if(action==='shortlist-app'){let a=state.applications.find(a=>a.id===id);if(a?.status==='Applied'){a.status='Shortlisted';save();render();toast('Pelamar masuk shortlist.')}}
if(action==='invite-app'){let a=state.applications.find(a=>a.id===id);if(!a||a.status!=='Shortlisted')return;const tm=team(a.teamId);if(!checkUserToInvite(a.candidateId,tm.id)){state.invitations.push({id:uid('inv'),teamId:tm.id,roleId:a.roleId,candidateId:a.candidateId,status:'Invited',createdAt:now()})}a.status='Invited';save();render();toast('Undangan dikirim ke kandidat. Belum terkonfirmasi.');return}
if(action==='simulate-candidate'){let i=state.invitations.find(i=>i.id===id);if(i?.status==='Invited'){i.status='Accepted';let a=state.applications.find(a=>a.teamId===i.teamId&&a.candidateId===i.candidateId);if(a)a.status='Accepted';save();render();toast('Kandidat menerima (simulasi). Perlu konfirmasi perekrut.')}return}
if(action==='final-confirm-app'){let a=state.applications.find(a=>a.id===id);if(!a||a.status!=='Accepted')return;let i=state.invitations.find(i=>i.teamId===a.teamId&&i.candidateId===a.candidateId&&i.status==='Accepted');if(i){tryFinal(i);if(i.status==='Confirmed'){a.status='Confirmed';save()}}return}
if(action==='withdraw-app'){let a=state.applications.find(a=>a.id===id);if(a?.status==='Applied'){a.status='Withdrawn';save();render();toast('Lamaran dibatalkan.')}return}
if(action==='approve-evidence'||action==='reject-evidence'||action==='revoke-evidence'||action==='demo-owner-approve'||action==='demo-owner-reject'){let g=state.evidence.find(g=>g.id===id);if(!g)return;const newStatus=action.endsWith('approve')||action==='approve-evidence'?'Approved':action==='revoke-evidence'?'Revoked':'Rejected';if(!['Requested','Approved'].includes(grantState(g)))return toast('Permintaan tidak aktif.',true);if(newStatus==='Approved'&&grantState(g)!=='Requested')return;g.status=newStatus;if(newStatus==='Approved')g.approvedAt=now();if(newStatus==='Revoked')g.revokedAt=now();save();render();toast(newStatus==='Approved'?'Akses dokumen spesifik disetujui (simulasi).':newStatus==='Revoked'?'Akses berikutnya telah dicabut.':'Permintaan ditolak. Dokumen tetap privat.');return}
if(action==='toggle-team-open'){let t=team(id);if(t?.ownerId==='me'){t.status=t.status==='Open'?'Closed':'Open';save();render();toast('Status tim diperbarui.')}return}
if(action==='show-recruiter'){const t=team(id);if(t&&person(t.ownerId))go('profile/'+t.ownerId);else toast('Profil perekrut belum tersedia.',true);return}
if(action==='toggle-more'){ui.profileMore=!ui.profileMore;render();return}
if(action==='add-record'){openModal('add-record');return}
if(action==='save-record'){const owned=state.records.filter(r=>r.userId==='me');if(owned.length>=20){let e=$('#record-error');if(e)e.textContent='Maksimal 20 entri.';return}let title=$('#rec-title')?.value.trim(),year=$('#rec-year')?.value,org=$('#rec-org')?.value.trim(),publicFlag=$('#rec-public')?.checked,pinned=$('#rec-pin')?.checked,evidence=$('#rec-evidence')?.checked;if(!title||!year||year.length!==4){let e=$('#record-error');if(e)e.textContent='Judul dan tahun 4 digit wajib diisi.';return}if(pinned&&publicFlag&&owned.filter(r=>r.pinned&&r.public).length>=3){let e=$('#record-error');if(e)e.textContent='Maksimal 3 highlight. Matikan pin atau lepas pin pada entri lain.';return}state.records.unshift({id:uid('rec'),userId:'me',title,year,organization:org,public:!!publicFlag,pinned:!!(pinned&&publicFlag),evidence:!!evidence});ui.modal=null;save();render();toast('Track record ditambahkan ke profil demo.');return}
if(action==='toggle-record-public'){let r=record(id);if(r?.userId!=='me')return;r.public=!r.public;if(!r.public)r.pinned=false;save();render();toast(r.public?'Judul tampil publik.':'Judul disembunyikan dari profil publik.');return}
if(action==='toggle-pin'){let r=record(id);if(r?.userId!=='me'||!r.public)return;let n=state.records.filter(x=>x.userId==='me'&&x.public&&x.pinned).length;if(!r.pinned&&n>=3)return toast('Maksimal 3 highlight.',true);r.pinned=!r.pinned;save();render();toast(r.pinned?'Ditambahkan ke highlight.':'Dilepas dari highlight.');return}
if(action==='ask-reset'){openModal('confirm-reset');return}
if(action==='reset-demo'){state=initial();ui.step=1;ui.modal=null;ui.filter={search:'',role:'',region:'',workMode:'all',minHours:'',onlyOpen:true};ui.inboxTab='invites';save();go('home');toast('Data demo berhasil direset.');return}
}

window.addEventListener('message',ev=>{const frame=document.getElementById('device-preview-frame');if(!ui.devicePreview||ev.source!==frame?.contentWindow||ev.data?.type!=='match-preview-sync')return;const value=ev.data.state;if(value&&Array.isArray(value.teams)&&value.profile)ui.previewState=value});
document.addEventListener('click',ev=>{const btn=ev.target.closest('[data-action]');if(!btn)return;if(btn.dataset.action==='backdrop'&&ev.target!==btn)return;ev.preventDefault();handleAction(btn.dataset.action,btn)});
document.addEventListener('submit',ev=>{if(ev.target.id==='recruit-form'){ev.preventDefault();if(!validateStep(ui.step)){render();toast('Lengkapi kolom yang ditandai.',true);return}if(ui.step===3){publish()}else{ui.step++;render();let form=$('#recruit-form');form?.scrollIntoView({block:'nearest',behavior:'smooth'})}}else if(ev.target.id==='onboard-form'){ev.preventDefault();const nick=$('#on-name').value.trim(),mail=$('#on-email').value.trim(),ss=skills($('#on-skill').value),hr=Number($('#on-hours').value);if(!nick||!/^\S+@\S+\.\S+$/.test(mail)||!ss.length||hr<1||hr>60)return toast('Periksa nickname, email, skill dan jam tersedia.',true);state.profile.nickname=nick;state.profile.email=mail;state.profile.emailConfirmed=false;state.profile.skills=ss.slice(0,12);state.profile.declaredStatus=$('#on-status').value;state.profile.hours=hr;state.profile.workMode=$('#on-work').value;state.profile.campus=$('#on-campus').value.trim();state.profile.region=$('#on-region').value.trim();state.teams.filter(t=>t.ownerId==='me').forEach(t=>{t.leaderName=nick});save();go('home');toast('Profil demo disimpan. Email belum diverifikasi.')}else if(ev.target.id==='profile-form'){ev.preventDefault();const nick=$('#set-nickname').value.trim();if(!nick)return toast('Nickname wajib diisi.',true);state.profile.nickname=nick;state.profile.campus=$('#set-campus').value.trim();state.profile.region=$('#set-region').value.trim();state.profile.declaredStatus=$('#set-status').value;state.profile.label=$('#set-label').value;state.profile.skills=skills($('#set-skills').value).slice(0,12);state.profile.hours=Math.max(1,Math.min(60,Number($('#set-hours').value)||1));state.profile.workMode=$('#set-work').value;state.teams.filter(t=>t.ownerId==='me').forEach(t=>{t.leaderName=nick;t.leaderLabel=state.profile.label});save();render();toast('Profil demo disimpan.')}});
document.addEventListener('input',ev=>{const key=ev.target.dataset?.draft;if(key){state.recruitDraft[key]=ev.target.value;save();updateDraftPreview()}});
document.addEventListener('change',ev=>{const key=ev.target.dataset?.draft;if(key){state.recruitDraft[key]=ev.target.value;save();updateDraftPreview()}});
document.addEventListener('keydown',ev=>{if(ev.key==='Escape'&&ui.modal){ui.modal=null;render()}if(ev.key==='Enter'&&ev.target.matches('.filters input')){ev.preventDefault();handleAction('apply-filter',ev.target)}if(ev.key==='Enter'&&ev.target.classList.contains('brand'))go('')});
window.addEventListener('hashchange',()=>{ui.profileMore=false;render()});
if(window.matchMedia)matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change',()=>{if(state.theme==='system')applyThemeDOM()});
render();
</script></body></html>
