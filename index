lass="feature-tile violet" data-action="tile-nav" data-to="recruit/new"><span class="tile-number">MODE 02</span><span class="tile-arrow">↗</span><strong>BENTUK<br>TIM.</strong><span class="tile-sub">Susun Team Commitment Card & rekrut anggota.</span></button></div><div class="between" style="margin:4px 0 18px"><h2 class="subhead">Rekomendasi untuk dijelajahi</h2><button class="text-link" data-action="go" data-to="explore?mode=teams">Lihat semuanya ↗</button></div><div class="card-grid">${state.teams.filter(t=>t.status==='Open'&&t.ownerId!=='me').slice(0,2).map(teamCard).join('')}</div>`}
function teamCard(t){const role=t.roles[0],app=state.applications.find(a=>a.teamId===t.id&&a.candidateId==='me'&&!['Withdrawn','Rejected'].includes(a.status));return `<article class="block-card result-card hoverable animate-in" data-morph="team" data-id="${esc(t.id)}"><div class="result-top"><span class="sticker ${t.status==='Open'?'':'neutral'}">● ${t.status==='Open'?'Open Recruitment':esc(t.status)}</span><span class="fine monospace">${esc(t.year)} ↗</span></div><div><h3>${esc(t.name)}</h3><p class="context">${esc(t.competition)} · ${esc(t.category)} (contoh)</p></div><div class="tags">${role.skills.slice(0,3).map(s=>`<span class="tag">${esc(s)}</span>`).join('')}</div><div class="result-facts"><div class="fact"><label>Dicari</label><strong>${esc(role.name)} × ${esc(role.slots)}</strong></div><div class="fact"><label>Komitmen</label><strong>${esc(role.hours)} jam/minggu · ${esc(t.workMode)}</strong></div><div class="fact"><label>Area</label><strong>${esc(t.region||'Remote')}</strong></div><div class="fact"><label>Perekrut</label><strong>${esc(t.leaderName)}</strong></div></div><div class="result-actions"><button class="btn ${app?'':'lime'} small" data-action="card-team" data-id="${esc(t.id)}">${app?'Lihat lamaran':'Lihat Tim'} ${icon('arrow',15)}</button><span class="fine muted">${app?formatStatus(app.status):'Team Commitment Card'}</span></div></article>`}
