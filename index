function teamDetail(id){let t=team(id);if(!t)return notFound();let own=t.ownerId==='me',role=t.roles[0],app=state.applications.find(a=>a.teamId===id&&a.candidateId==='me'&&a.status!=='Withdrawn');return `<button class="btn small ghost" data-action="go" data-to="explore?mode=teams" style="margin-bottom:20px">${icon('back',16)} Kembali ke Explore</button><div class="detail-grid animate-in"><section><div class="detail-hero"><div class="row"><span class="sticker white">● ${esc(t.status==='Open'?'Open Recruitment':t.status)}</span><span class="sticker black">TEAM COMMITMENT CARD</span></div><h1>${esc(t.name)}</h1><p>${esc(t.competition)} ${esc(t.year)} · ${esc(t.category)} · Informasi lomba diisi perekrut (belum diverifikasi)</p></div><div class="block-card" style="margin-bottom:20px"><h2 class="info-title">01 / Role yang dibutuhkan</h2><div class="between"><div><h3 style="font-size:26px">${esc(role.name)}</h3><p class="fine muted" style="margin-top:4px">Slot dibuka: ${esc(role.slots)} · ${esc(role.hours)} jam/minggu</p></div><span class="sticker violet">OPEN ROLE</span></div><div class="tags" style="margin-top:15px">${role.skills.map(s=>`<span class="tag">${esc(s)}</span>`).join('')}</div><div class="block-card" style="margin-bottom:20px"><h2 class="info-title">02 / Komitmen yang diharapkan</h2><div class="commit-grid"><div class="commit-box"><span class="fine muted">${icon('clock',15)} Kontribusi</span><strong>${esc(role.hours)} jam / minggu</strong></div><div class="commit-box"><span class="fine muted">${icon('users',15)} Jadwal koordinasi</span><strong>${esc(role.meeting)}</strong></div><div class="commit-box"><span class="fine muted">${icon('pin',15)} Cara kerja</span><strong>${esc(t.workMode)} · ${esc(t.region||'Remote')}</strong></div><div class="commit-box"><span class="fine muted">${icon('check',15)} Target</span><strong>${esc(role.goal)}</strong></div></div><div class="rule"></div><h3 style="margin-bottom:9px">Rencana kerja nyata</h3><p class="muted" style="fon