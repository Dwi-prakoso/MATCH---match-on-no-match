function landing(){return `<div class="hero"><div class="hero-copy"><div class="hero-stamp"><span class="sticker violet">✳ FOR THE COMPETITION PEOPLE</span></div><div class="eyebrow">Rekan lomba bukan sekadar nama</div><h1 class="display">KETEMU TIM<br><span class="marker">YANG KLIK.</span></h1><p class="lead">Bukan cuma cocok skill. Cocok komitmen. Cari rekan lomba, cek track record, lalu putuskan bareng — tanpa umbar dokumen pribadi.</p><div class="row"><button class="btn lime" data-action="go" data-to="explore?mode=teams">Cari Tim ${icon('arrow')}</button><button class="btn" data-action="go" data-to="recruit/new">Mulai Rekrut ${icon('plus',17)}</button><button class="text-link" data-action="go" data-to="onboarding">Buat profil demo ↗</button></div></div><div class="hero-board"><div class="hero-shapes"></div><div class="board-top"><span class="sticker black">FIND YOUR PEOPLE ↗</span><div class="board-brand"><img src="${IMAGES.monoLight}" alt="Monogram Match" /></div></div><div class="board-big">NO MATCH?<span>KEEP LOOKING.</span></div><div class="board-bottom"><span>01 / TEAMWORK IS EVERYTHING<br>02 / COMMITMENT COMES FIRST</span><span class="rotate">✳</span></div></div></div><div class="section-intro"><span class="number-box">↗</span><div><div class="eyebrow">Satu akun · Dua mode</div><h2 class="section-title">Cara mainmu, pilihanmu.</h2></div></div><div class="quick-actions"><button class="feature-tile lime" data-action="tile-nav" data-to="explore?mode=teams"><span class="tile-number">01 / JOIN</span><span class="tile-arrow">↗</span><strong>CARI<br>TIM.</strong><span class="tile-sub">Temukan tim terbuka dengan komitmen yang jelas.</span><span class="tile-deco">↗</span></button><button class="feature-tile violet" data-action="tile-nav" data-to="recruit/new"><span class="tile-number">02 / RECRUIT</span><span class="tile-arrow">↗</span><strong>REKRUT<br>ANGGOTA.</strong><span class="tile-sub">Buka posisi dan temukan partner yang sesuai.</span><span class="tile-deco